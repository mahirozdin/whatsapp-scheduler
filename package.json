{
  "name": "whatsapp-scheduler",
  "version": "0.1.0",
  "description": "Schedule WhatsApp messages from your own account. Tiny self-hosted web UI + MCP server for Claude Code / Codex, built on wacli.",
  "type": "module",
  "bin": {
    "whatsapp-scheduler": "bin/whatsapp-scheduler.js"
  },
  "files": [
    "bin",
    "src",
    "public"
  ],
  "scripts": {
    "start": "node bin/whatsapp-scheduler.js",
    "mcp": "node bin/whatsapp-scheduler.js mcp",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-scheduler",
    "schedule-whatsapp-message",
    "scheduled-messages",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "wacli",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahirozdin/whatsapp-scheduler.git"
  },
  "homepage": "https://github.com/mahirozdin/whatsapp-scheduler#readme",
  "author": "Mahir Taha Özdin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
